{
  "name": "OBL/PBL Trainer",
  "short_name": "OBL & PBL",
  "start_url": "./",
  "scope": "./",
  "id": "./manifest.webmanifest",
  "display": "standalone",
  "background_color": "#020813",
  "theme_color": "#d9e9ff",
  "description": "Train and learn OBL and PBL in one unified trainer, with many customization possibilities.",
  "icons": [
    {
      "src": "favicon.ico",
      "sizes": "16x16 20x20 24x24 32x32 48x48 64x64 128x128 256x256",
      "type": "image/x-icon",
      "purpose": "any"
    },
    {
      "src": "icon-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ]
}
